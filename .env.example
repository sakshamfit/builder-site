# ---------------------------------------------------------------------------
# Cinema at Madhuban — environment template
#
# Copy to `.env.local` for local work. EVERY value below is an owner/operator
# decision. The placeholders are deliberately empty so the site falls back to
# an honest "not yet confirmed" state rather than presenting a guess as fact.
# ---------------------------------------------------------------------------

# --- Brand identity (owner confirmation required before production) --------
# Working title only. Replace with the confirmed trade name once approved.
NEXT_PUBLIC_BRAND_DISPLAY_NAME="Cinema at Madhuban"
# Leave empty until the operator authorises a mall/operator attribution line.
NEXT_PUBLIC_BRAND_ATTRIBUTION=""
# Public web domain. Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Venue ----------------------------------------------------------------
# The venue's own timezone. Showtimes are stored with explicit offsets; this
# value decides how they are displayed. Do not change without owner sign-off.
NEXT_PUBLIC_VENUE_TIMEZONE="Asia/Kolkata"

# --- Schedule data source -------------------------------------------------
# "programme" (default) serves the sourced release calendar in data/programme.json
#   and states plainly that the cinema's own screening times are not connected.
# "live" renders the venue feed described in FEED_CONTRACT.md, and is only entered
#   when SCHEDULE_FEED_URL is also set.
# There is no sample-data mode: the release calendar is real and cited, and the feed
# is the only thing that can supply screening times.
NEXT_PUBLIC_DATA_MODE="programme"

# Server-only feed credentials. Never prefix these with NEXT_PUBLIC_.
# SCHEDULE_FEED_URL=https://partner.example.com/venue/madhuban/programme.json
# SCHEDULE_FEED_TOKEN=

# Artwork hosts, comma-separated, no scheme. REQUIRED for any poster to appear:
# the feed validator drops artwork from any host not listed here, and next/image
# will not optimise it either. Empty means "no remote artwork", which is the
# safe default. Only list CDNs you are licensed to pull film artwork from.
# POSTER_HOST_ALLOWLIST=cdn.partner.example.com

# How old a feed payload may be before the site labels it stale. Default 12.
# SCHEDULE_STALE_AFTER_HOURS=12

# How long the fetched payload may be reused before it is re-fetched, in
# seconds. Default 300 (five minutes). Lower for a busy box office.
# SCHEDULE_REVALIDATE_SECONDS=300

# --- Ticketing provider handoff -------------------------------------------
# The display name shown on the handoff button, e.g. "the venue's ticketing
# partner". Leave empty and the site will not render a booking button at all.
NEXT_PUBLIC_TICKETING_PROVIDER_NAME=""

# Deep-link template. Must be https and must contain at least the {movieId},
# {date} and {venueId} tokens. Example shape (NOT a real endpoint):
#   https://tickets.example.com/cinema/{venueId}?film={movieId}&date={date}
NEXT_PUBLIC_TICKETING_URL_TEMPLATE=""

# Comma-separated hostnames the template is allowed to point at. The handoff is
# refused if the built URL resolves anywhere else.
NEXT_PUBLIC_TICKETING_ALLOWED_HOSTS=""

# --- Contact (owner-supplied) --------------------------------------------
NEXT_PUBLIC_VENUE_PHONE=""
NEXT_PUBLIC_VENUE_EMAIL=""
